# Secrets — never commit
.env
credentials.json
token.json

# Intermediates — regenerable
.tmp/*
!.tmp/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Auto-installed Claude Code skill packages — fetched from external sources
# on demand, not authored for this project. Keep them off disk from being
# committed; they don't belong in a client site's history.
.claude/skills/
.agents/skills/
skills-lock.json

# scripts/contrast.cjs writes its own debug screenshots to cwd — disposable
# diagnostic output, not site assets.
web/ct-*.png

# Generated/scratch media kept on disk for reference, not part of the site.
# Nothing in web/ reads these; AI.png stays tracked because web/README.md names
# it as the source the brand assets were derived from.
/images/
/ChatGPT Image*.png
/final.png
